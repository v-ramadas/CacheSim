new file mode 100644
index 0000000..af1b69b
--- /dev/null
+++ b/inc/bloom_filter.h
@@ -0,0 +1,78 @@
+#ifndef __BLOOM_FILTER_H__
+#define __BLOOM_FILTER_H__
+
+#include <cstdint>
+#include <vector>
+
+// Persistent (never-decaying) bit array of addresses that have previously
+// been evicted from the LLC. Unlike the FIFO victim cache, capacity here is
+// probabilistic rather than exact: entries are never evicted, so an address
+// seen arbitrarily far in the past can still test positive, at the cost of
+// a false-positive rate that grows with the number of distinct addresses
+// inserted relative to num_bits.
+class BloomFilter {
+    std::vector<uint64_t> bits;
+    uint64_t num_bits_ = 0;
+    uint64_t num_hashes_ = 1;
+
+    static uint64_t hash1(uint64_t x) {
+        x ^= x >> 33;
+        x *= 0xff51afd7ed558ccdULL;
+        x ^= x >> 33;
+        x *= 0xc4ceb9fe1a85ec53ULL;
+        x ^= x >> 33;
+        return x;
+    }
+
+    static uint64_t hash2(uint64_t x) {
+        x += 0x9e3779b97f4a7c15ULL;
+        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+        x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+        x ^= (x >> 31);
+        return x | 1; // must be odd/non-zero so double hashing covers all slots
+    }
+
+    public:
+    uint64_t debug_insert_count = 0;
+    uint64_t debug_lookup_count = 0;
+    uint64_t debug_hit_count = 0;
+
+    void resize(uint64_t num_bits, uint64_t num_hashes) {
+        num_bits_ = num_bits;
+        num_hashes_ = num_hashes == 0 ? 1 : num_hashes;
+        bits.assign((num_bits_ + 63) / 64, 0);
+        debug_insert_count = 0;
+        debug_lookup_count = 0;
+        debug_hit_count = 0;
+    }
+
+    uint64_t num_bits() const { return num_bits_; }
+
+    void insert(uint64_t address) {
+        if (num_bits_ == 0) return;
+        debug_insert_count++;
+        uint64_t h1 = hash1(address);
+        uint64_t h2 = hash2(address);
+        for (uint64_t i = 0; i < num_hashes_; ++i) {
+            uint64_t bit_idx = (h1 + i * h2) % num_bits_;
+            bits[bit_idx / 64] |= (1ULL << (bit_idx % 64));
+        }
+    }
+
+    bool possibly_contains(uint64_t address) {
+        if (num_bits_ == 0) return false;
+        debug_lookup_count++;
+        uint64_t h1 = hash1(address);
+        uint64_t h2 = hash2(address);
+        for (uint64_t i = 0; i < num_hashes_; ++i) {
+            uint64_t bit_idx = (h1 + i * h2) % num_bits_;
+            if (!(bits[bit_idx / 64] & (1ULL << (bit_idx % 64)))) {
+                return false;
+            }
+        }
+        debug_hit_count++;
+        return true;
+    }
+};
+
+#endif
