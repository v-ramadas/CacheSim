@@ -0,0 +1,108 @@
+#ifndef __THRASH_COUNTER_H__
+#define __THRASH_COUNTER_H__
+
+#include <cstdint>
+#include <vector>
+#include <deque>
+#include <unordered_map>
+#include <utility>
+
+// Detects "this address was evicted from LLC and missed again soon after"
+// using a small bounded FIFO (same recency mechanism as the victim cache),
+// and on each such event increments a saturating counter for that address
+// in a fixed-size hashed table that persists for the entire run (unlike the
+// FIFO, table entries are never explicitly removed - only decayed). At fill
+// time, any address whose counter has crossed a threshold is treated as a
+// thrash-prone / hub-like signal, even if that particular eviction has long
+// since fallen out of the recency FIFO - the counter is what "remembers"
+// across a longer horizon than the FIFO's window, while still requiring
+// repeated fast re-misses (not a single one, unlike the victim cache) and
+// decaying on ordinary (non-thrashing) misses so it isn't a one-way,
+// never-forgetting signal like a plain Bloom filter.
+class ThrashCounter {
+    std::unordered_map<uint64_t, uint64_t> recent_present;
+    std::deque<std::pair<uint64_t, uint64_t>> recent_fifo;
+    uint64_t next_seq = 0;
+    size_t recency_capacity_ = 0;
+
+    std::vector<uint8_t> table;
+    uint64_t table_size_ = 0;
+    uint8_t max_counter_ = 3;
+    uint64_t threshold_ = 2;
+
+    static uint64_t hash_address(uint64_t address) {
+        uint64_t x = address;
+        x ^= x >> 33;
+        x *= 0xff51afd7ed558ccdULL;
+        x ^= x >> 33;
+        x *= 0xc4ceb9fe1a85ec53ULL;
+        x ^= x >> 33;
+        return x;
+    }
+
+    public:
+    uint64_t debug_evict_marks = 0;
+    uint64_t debug_fast_remiss = 0;
+    uint64_t debug_slow_miss = 0;
+    uint64_t debug_positive_signals = 0;
+    uint64_t debug_lookups = 0;
+
+    void resize(size_t recency_capacity, uint64_t table_size, uint8_t max_counter, uint64_t threshold) {
+        recency_capacity_ = recency_capacity;
+        recent_present.clear();
+        recent_fifo.clear();
+        next_seq = 0;
+        table_size_ = table_size;
+        max_counter_ = max_counter;
+        threshold_ = threshold;
+        table.assign(table_size_, 0);
+        debug_evict_marks = 0;
+        debug_fast_remiss = 0;
+        debug_slow_miss = 0;
+        debug_positive_signals = 0;
+        debug_lookups = 0;
+    }
+
+    // Called on an LLC eviction of a line already gated by the caller
+    // (e.g. serviced_from_llc[way_idx] > 0).
+    void mark_evicted(uint64_t address) {
+        if (recency_capacity_ == 0) return;
+        debug_evict_marks++;
+        uint64_t seq = next_seq++;
+        recent_present[address] = seq;
+        recent_fifo.push_back({address, seq});
+        while (recent_fifo.size() > recency_capacity_) {
+            const auto& front = recent_fifo.front();
+            auto it = recent_present.find(front.first);
+            if (it != recent_present.end() && it->second == front.second) { recent_present.erase(it); }
+            recent_fifo.pop_front();
+        }
+    }
+
+    // Called on every LLC fill (cache miss). Returns whether this address's
+    // persistent counter has crossed the thrash threshold. A fast re-miss
+    // (address was recently evicted) increments the counter; an ordinary
+    // miss with no recent eviction decays it.
+    bool on_fill(uint64_t address) {
+        if (table_size_ == 0) return false;
+        debug_lookups++;
+        uint64_t idx = hash_address(address) % table_size_;
+
+        auto it = recent_present.find(address);
+        bool fast_remiss = (it != recent_present.end());
+        if (fast_remiss) {
+            recent_present.erase(it);
+            debug_fast_remiss++;
+            if (table[idx] < max_counter_) table[idx]++;
+        } else {
+            debug_slow_miss++;
+            if (table[idx] > 0) table[idx]--;
+        }
+
+        bool positive = table[idx] >= threshold_;
+        if (positive) debug_positive_signals++;
+        return positive;
+    }
+};
+
+#endif
